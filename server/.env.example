# Copy to .env (or set in your host's dashboard). Never commit real values.

PORT=3000
# Public HTTPS URL of this server once deployed (used for mock checkout links).
PUBLIC_URL=https://glamoriz-tools.example.com
# Shared secret Chord sends as "Authorization: Bearer ..." (register the MCP server with auth_type=bearer).
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# Paystack TEST secret key (sk_test_...). Leave empty to use the built-in mock checkout.
# The server refuses to start with an sk_live_ key.
PAYSTACK_SECRET_KEY=
# Optional: where Paystack sends the customer after paying (e.g. a "return to WhatsApp" page).
PAYSTACK_CALLBACK_URL=

# Chord API access for scheduling follow-ups (needs teammate:update). Leave empty and the agent
# falls back to its own schedule_reminder tool.
CHORD_BASE_URL=https://api.chordhq.xyz
CHORD_API_KEY=
CHORD_WORKSPACE_ID=
CHORD_TEAMMATE_ID=
# Only used by chord.http (copy from "List MCP servers").
CHORD_MCP_SERVER_ID=
# DIRECT_LINE delivers into a Chord thread by id; WHATSAPP uses the workspace's WhatsApp connector.
CHORD_FOLLOWUP_PLATFORM=DIRECT_LINE

# Demo: compress follow-ups into minutes (check-in at +N min, reorder at +2N min). 0 = real timings.
DEMO_FOLLOWUP_MINUTES=2

# Nigerian VAT in percent. Listed prices and delivery fees already include it; quotes and orders show the VAT portion.
VAT_RATE=7.5

# How the agent formats replies: plain (no Markdown or HTML: right for the WhatsApp simulator), whatsapp (*bold*,
# _italic_), markdown or html. Optional per-channel overrides, e.g. whatsapp=whatsapp,web=markdown,email=html.
REPLY_FORMAT=plain
REPLY_FORMAT_BY_CHANNEL=

# Slack or Discord incoming-webhook URL for owner alerts (complaints, mismatched payments, stock shortfalls).
OWNER_ALERT_WEBHOOK_URL=

# Where the JSON store lives. Use a persistent disk on your host.
DATA_DIR=
