{
  "name": "glamoriz-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Glamoriz tool server for a Chord teammate: catalogue, orders, Paystack (test mode) and follow-ups over MCP Streamable HTTP.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "zod": "4.6.5"
  }
}
